<resources>
    <!-- Light (default). A night-qualified copy lives in values-night/ so the app
         follows the system dark setting. The Compose UrsaTheme drives in-app colors;
         this mainly controls the splash/window background and system bars. -->
    <style name="Theme.URSA" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
