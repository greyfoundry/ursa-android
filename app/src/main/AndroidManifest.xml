<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Post the notification when a monitor changes state (runtime-requested on API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.URSA">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Handles Pause/Resume actions on a monitor notification. NOT exported:
             only the app's own notification PendingIntents trigger it. -->
        <receiver
            android:name=".core.push.MonitorActionReceiver"
            android:exported="false" />

        <!-- Home-screen widget. Exported as required by the AppWidget framework;
             it only receives system APPWIDGET broadcasts and shows cached counts. -->
        <receiver
            android:name=".ui.widget.MonitorWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/monitor_widget_info" />
        </receiver>

        <!-- Quick Settings tile: glanceable up/down status. Exported + bound with the
             system tile permission, as required by the Quick Settings framework. -->
        <service
            android:name=".ui.tile.StatusTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_monitor"
            android:label="URSA status"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- UnifiedPush delivery target. NOT exported: the connector ships its own
             internal receiver that forwards push events to this service. -->
        <service
            android:name=".core.push.UrsaPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
