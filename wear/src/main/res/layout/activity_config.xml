<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:paddingVertical="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_prompt"
            android:textAlignment="center"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/status_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/config_hint"
            android:inputType="textUri"
            android:autofillHints="url"
            android:importantForAutofill="no"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/config_actions_prompt"
            android:textAlignment="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/config_actions_desc"
            android:textAlignment="center"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/paired_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/config_not_paired"
            android:textAlignment="center"
            android:textStyle="bold" />

        <Button
            android:id="@+id/clear_pairing"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/config_clear_pairing" />

        <Button
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/config_save"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
